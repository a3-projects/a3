---
import { ContactForm } from "@/modules/routing/components/ContactForm";
import { button } from "@/ui/Button";
import { LogoDots } from "@/ui/LogoDots";
---

<footer id="kontakt" class="bg-back text-front border-t border-solid border-border flex flex-col relative">
  <div class="relative pb-10 pt-20">
    <!-- Logo dots background -->
    <LogoDots
      className="z-0"
      client:idle
      dotSize={1.5}
      dotSpacing={6}
      bgDotColor="var(--color-muted-back)"
      logoDotColor="var(--color-primary-back)"
      logoPercentage={200}
    />
    <div class="absolute inset-0 bg-back/10 backdrop-blur-[1px] z-0"></div>

    <div class="flex flex-col gap-4 px-6 relative max-w-prose w-full mx-auto">
      <div>
        <div class="flex items-center justify-center flex-col">
          <h2
            id="contact-title"
            class="text-4xl inline-block bg-gradient-to-br from-front text-center mx-auto via-front to-muted-front text-transparent bg-clip-text"
          >
            Kurzer Kennenlern‑Call?
          </h2>
          <p id="contact-description" class="mt-5 text-lg text-center">
            15-30 Minuten reichen oft, um zu sehen, ob es passt. Wir kommen vorbereitet, du gehst mit
            Klarheit.
          </p>
        </div>

        <div class="mx-auto mt-10 overflow-hidden flex items-center justify-center flex-col gap-4">
          <a
            href="https://calendly.com/hello-a3-team/30min"
            target="_blank"
            rel="noopener noreferrer"
            class={button({
              size: "lg",
            })}
          >
            Jetzt Termin vereinbaren
          </a>
          <div class="w-full">
            <ContactForm client:idle />
          </div>
        </div>

        <p class="text-center mx-auto font-light mt-20 text-muted-front">
          A3 Team – Gemeinsam im Takt zu deinem Ziel 🤝
        </p>
      </div>
    </div>
  </div>
  <div
    class="self-start relative flex gap-4 bg-back w-full h-12 px-5 items-center border-t border-solid border-border"
  >
    <a class="text-sm hover:underline underline-offset-4" href="/impressum">Impressum</a>
    <div class="h-1/3 w-[1px] bg-border"></div>
    <a class="text-sm hover:underline underline-offset-4" href="/datenschutz">Datenschutz</a>
  </div>
</footer>
