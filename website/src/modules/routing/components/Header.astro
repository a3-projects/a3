---
import { Navbar } from "@/ui/Navbar";
import { Logo } from "@/ui/icons/Logo";
import { ThemeToggle } from "@/ui/ThemeToggle";
import { button } from "@/ui/Button";
---

<header>
  <Navbar client:idle>
    <Navbar.List>
      <Navbar.ListItem className="group hover:before:bg-front ">
        <Navbar.Link
          href="/#start"
          className="flex items-center gap-2 z-10 h-full w-full text-front group-hover:text-white "
        >
          <Logo size={24} className="text-front group-hover:text-back" />

          <div class="text-front group-hover:text-back text-[20px]">A3 Team</div>
        </Navbar.Link>
      </Navbar.ListItem>

      <!-- <Navbar.ListItem>
        <Navbar.Link href="/#kontakt">Kontakt</Navbar.Link>
      </Navbar.ListItem> -->

      <div
        class="p-1 ml-auto flex gap-2 group-data-[navbar-visible=true]/navbar:opacity-100 opacity-0 transition-opacity duration-500"
      >
        <ThemeToggle client:idle />
        <a class={button({ size: "sm" })} href="#kontakt">Kennenlern-Call</a>
      </div>
    </Navbar.List>
  </Navbar>
</header>
