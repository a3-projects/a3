---
import Layout from "@/layouts/Layout.astro";
import BaseHead from "@/components/BaseHead.astro";
import { Main } from "@/ui/Main";

import TeamSection from "@/domains/home/TeamSection.astro";
import HiringSection from "@/domains/home/HiringSection.astro";
import StartSection from "@/domains/home/StartSection.astro";
import HowWeWorkSection from "@/domains/home/HowWeWorkSection.astro";
import ToolsSection from "@/domains/home/ToolsSection.astro";
import FAQSection from "@/domains/home/FAQSection.astro";
import PricingSection from "@/domains/home/PricingSection.astro";
import WhatWeDo from "@/domains/home/WhatWeDo.astro";
import OutroSection from "@/domains/home/OutroSection.astro";
---

<Layout>
  <BaseHead
    slot="head"
    title="A3 Team"
    description="Egal ob Legacy oder Greenfield. Wir bringen Ihren Code mit modernen, agilen Prozessen in Einklang."
  />

  <Main>
    <StartSection />
    <WhatWeDo />

    <HowWeWorkSection />
    <OutroSection />

    <TeamSection />
    <PricingSection />
    <FAQSection />
    <!-- <HiringSection /> -->
    <ToolsSection />
  </Main>
</Layout>
