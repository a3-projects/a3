---
import Layout from "@/layouts/Layout.astro";
import BaseHead from "@/components/BaseHead.astro";
import { Main } from "@/ui/Main";

import TeamSection from "@/domains/home/TeamSection.astro";
import StartSection from "@/domains/home/StartSection.astro";
import HowWeWorkSection from "@/domains/home/HowWeWorkSection.astro";
import FAQSection from "@/domains/home/FAQSection.astro";
import PricingSection from "@/domains/home/PricingSection.astro";
import WhatWeAchieveSection from "@/domains/home/WhatWeAchieveSection.astro";
import TransitionSection from "@/domains/home/TransitionSection.astro";
import ComparisonChartSection from "@/domains/home/ComparisonChartSection.astro";
import CompanyMarquee from "@/domains/home/CompanyMarquee.astro";
import ServicesBentoSection from "@/domains/home/ServicesBentoSection.astro";
import AnimateBlurFadeIn from "@/domains/home/AnimateBlurFadeIn.astro";
---

<Layout>
  <BaseHead
    slot="head"
    title="A3 Team – Kein Bock mehr auf WordPress?"
    description="Drei Köpfe, ein Puls: Wir holen deine Website raus aus der WordPress-Plugin-Hölle – hin zu einem schnellen, wartungsarmen Auftritt, der für dich verkauft."
  />

  <Main>
    <AnimateBlurFadeIn />
    <StartSection />
    <WhatWeAchieveSection />
    <CompanyMarquee />
    <HowWeWorkSection />
    <TransitionSection />
    <TeamSection />
    <ComparisonChartSection />
    <ServicesBentoSection />
    <PricingSection />
    <FAQSection />
  </Main>
</Layout>
