---
import { TextReveal } from "@/ui/TextReveal";
---

<section class="relative bg-back">
  <div class="container text-6xl font-bold z-10 relative mx-auto">
    <TextReveal
      className="container-el"
      client:idle
      text="Software endlich richtig anpacken, mit dem A3 Team"
    >
      <div class="outro-blur sticky container mx-auto w-full h-0 top-0">
        <div class="w-full h-20 rounded-full blur-[100px] bg-primary-600/50"></div>
      </div>
      <div
        class="absolute container mx-auto w-full h-full top-0 left-0 flex justify-around pointer-events-none"
      >
        <div
          class="outro-line w-[1px] h-[calc(100%_+_400px)] bg-gradient-to-b to-back from-70% from-border/50"
        >
        </div>
        <div
          class="outro-line w-[1px] h-[calc(100%_+_600px)] bg-gradient-to-b to-back from-70% from-primary-back/30"
        >
        </div>
        <div
          class="outro-line w-[1px] h-[calc(100%_+_400px)] bg-gradient-to-b to-back from-70% from-border/50"
        >
        </div>

        <div
          class="outro-line w-[1px] h-[calc(100%_+_600px)] bg-gradient-to-b to-back from-70% from-primary-back/30"
        >
        </div>

        <div
          class="outro-line w-[1px] h-[calc(100%_+_400px)] bg-gradient-to-b to-back from-70% from-border/50"
        >
        </div>
        <div
          class="outro-line w-[1px] h-[calc(100%_+_600px)] bg-gradient-to-b to-back from-70% from-primary-back/30"
        >
        </div>
        <div
          class="outro-line w-[1px] h-[calc(100%_+_400px)] bg-gradient-to-b to-back from-70% from-border/50"
        >
        </div>
      </div>
    </TextReveal>
  </div>
</section>

<script>
  import { animate, scroll } from "motion";

  const lines = document.querySelectorAll(".outro-line");

  if (lines) {
    lines.forEach((line) => {
      scroll(animate(line, { scaleY: [0, 1], originX: 0, originY: 0 }), {
        target: line,
        offset: ["0 0", "1 1"],
      });
    });
  }

  const blur = document.querySelector(".outro-blur");

  if (blur) {
    scroll(animate(blur, { opacity: [0, 1], originX: 0, originY: 0 }), {
      target: lines[0],
      offset: ["0 0", "1 1"],
    });
  }
</script>
