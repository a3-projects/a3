---
import { Logo } from "@/ui/icons/Logo";
import { TextHighlight } from "@/ui/TextHighlight";
import { GradientHoverCard } from "@/domains/home/GradientHoverCard";
import { DotBackground } from "@/domains/home/DotBackground";
import { button } from "@/ui/Button";
---

<section
  id="was-wir-bewirken"
  class="overflow-hidden z-10 py-20 relative border-t border-neutral-800 flex flex-col bg-black"
>
  <div class="animate-what-we-do opacity-0">
    <div class="flex flex-col items-start z-10 max-w-[1200px] w-full mx-auto px-6">
      <h2
        class="animate-what-we-do text-4xl inline-block bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
      >
        Software, die nicht bremst – <br />sondern dein Business voranbringt.
      </h2>
      <p class="animate-what-we-do text-lg mt-4 text-neutral-400 font-serif max-w-prose">
        Viele Unternehmen kämpfen ihren Tools und Anwendungen, die kompliziert sind, Zeit fressen oder nicht
        mitwachsen. Wir entwickeln Software, die spürbar entlastet und echten ROI bringt.
      </p>
    </div>
    <div class="container mx-auto px-4 z-10 mt-10 max-w-[1200px]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-template-columns-[300px]">
        <GradientHoverCard
          client:idle
          className="animate-what-we-do relative z-10 backdrop-blur-sm border border-neutral-800 p-6 rounded-xl"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-4 mb-4">
              <h4 class="text-xl text-white">Mehr zahlende Kunden</h4>
            </div>
            <p class="text-neutral-400 font-serif text-base leading-relaxed">
              <TextHighlight>Intuitive, schnelle Anwendungen</TextHighlight>, die Nutzer begeistern – und sie
              gerne wiederkommen lassen.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-what-we-do relative z-10  backdrop-blur-sm border border-neutral-800 p-6 rounded-xl"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-4 mb-4">
              <h4 class="text-xl text-white">Mehr Fokus im Alltag</h4>
            </div>
            <p class="text-neutral-400 font-serif text-base leading-relaxed">
              <TextHighlight>Intelligente Automatisierung</TextHighlight> nimmt Routineaufgaben ab und schafft
              Raum für Strategie und Kreativität.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-what-we-do relative z-10 backdrop-blur-sm border border-neutral-800 p-6 rounded-xl"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-4 mb-4">
              <h4 class="text-xl text-white">Zufriedene Mitarbeiter</h4>
            </div>
            <p class="text-neutral-400 font-serif text-base leading-relaxed flex-grow">
              <TextHighlight>Durchdachte Tools</TextHighlight> vereinfachen komplexe Abläufe – Frust sinkt, Motivation
              steigt.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-what-we-do relative z-10 backdrop-blur-sm border border-neutral-800 p-6 rounded-xl"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-4 mb-4">
              <h4 class="text-xl text-white">Nachhaltiges Wachstum</h4>
            </div>
            <p class="text-neutral-400 font-serif text-base leading-relaxed">
              Fundament für morgen – <TextHighlight>Architektur</TextHighlight>, die mit deinem Business
              skaliert.
            </p>
          </div>
        </GradientHoverCard>

        <div
          class="hidden lg:flex animate-what-we-do relative rounded-xl p-8 items-center justify-center w-full aspect-square md:aspect-auto"
        >
          <div class="absolute flex inset-0">
            <DotBackground
              client:idle
              width={16}
              height={16}
              className="[mask-image:radial-gradient(220px_circle_at_center,white,transparent)]"
            />
          </div>

          <div class="flex absolute w-full h-full -translate-y-2 translate-x-2">
            <Logo
              className="text-primary-500 blur-xl m-auto  transition-colors duration-300 z-0"
              size="70%"
            />
          </div>
          <div class="absolute flex w-full h-full -translate-y-2 translate-x-2">
            <Logo className="text-primary-200  m-auto hover:text-primary-300 " size="70%" />
          </div>
        </div>
        <!-- Card 6: Energie für Innovation -->
        <GradientHoverCard
          client:idle
          className="animate-what-we-do relative z-10 backdrop-blur-sm border border-neutral-800 p-6 rounded-xl"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-4 mb-4">
              <!-- <div class="icon-wrapper">
              <LightbulbIcon className="w-8 h-8 text-primary-400" strokeWidth={1.5} />
            </div> -->
              <h4 class="text-xl text-white">Energie für Innovation</h4>
            </div>
            <p class="text-neutral-400 font-serif text-base leading-relaxed">
              <TextHighlight>Reibungslose Abläufe</TextHighlight> lassen Ideen entstehen – statt ständig Feuer
              löschen.
            </p>
          </div>
        </GradientHoverCard>
      </div>
    </div>
    <div class="animate-what-we-do text-center flex items-center justify-center px-6 mt-20">
      <a
        href="#kontakt"
        class={button({
          size: "lg",
        })}>Kennenlern-Call vereinbaren</a
      >
    </div>
  </div>

  <script>
    import { animate, inView } from "motion";

    // Small helper that finds the meaningful pieces inside the section
    const animateEls = document.querySelectorAll(".animate-what-we-do");
    const section = animateEls[0];
    if (section || animateEls.length > 0) {
      console.warn("No elements with class 'animate-what-we-do' found.");

      // Query the main parts we want to animate by explicit ids.

      const elements = [...animateEls].filter(Boolean);

      // Use motion's inView helper to detect visibility and animate with a stagger
      inView(
        section,
        () => {
          elements.forEach((el, index) => {
            if (!el) return;
            animate(
              el,
              {
                opacity: [0, 1],
                y: [100, 0],
                filter: ["blur(20px)", "blur(0px)"],
              },
              {
                delay: (index || 0) * 0.2,
                duration: 0.5,
              }
            );
          });
        },
        { amount: 0.2 }
      );
    }
  </script>
</section>
