---
// Import all company logos
import AdidasLogo from "../../assets/images/company-logos/company-logo-adidas-white.svg";
import DatevLogo from "../../assets/images/company-logos/company-logo-datev-white.svg";
import KickerLogo from "../../assets/images/company-logos/company-logo-kicker-white.svg";
import NordbayernLogo from "../../assets/images/company-logos/company-logo-nordbayern-white.svg";
import FraunhoferIISLogo from "../../assets/images/company-logos/company-logo-fraunhofer-iis-white.svg";

import PaesslerLogo from "../../assets/images/company-logos/company-logo-paessler-white.svg";
import SellwerkLogo from "../../assets/images/company-logos/company-logo-sellwerk-white.svg";
import SiemensLogo from "../../assets/images/company-logos/company-logo-siemens-white.svg";

// Create array of company logos with alt text and width
const companyLogos = [
  { src: AdidasLogo, alt: "Adidas", width: 75 },
  { src: KickerLogo, alt: "Kicker", width: 150 },

  { src: NordbayernLogo, alt: "Nordbayern", width: 150 },
  { src: DatevLogo, alt: "Datev", width: 75 },

  { src: FraunhoferIISLogo, alt: "Fraunhofer IIS", width: 150 },

  { src: PaesslerLogo, alt: "Paessler", width: 150 },
  { src: SellwerkLogo, alt: "Sellwerk", width: 150 },
  { src: SiemensLogo, alt: "Siemens", width: 150 },
];
---

<section class="relative overflow-hidden border-t border-b border-solid border-border py-10 bg-back">
  <div class="flex items-center justify-center">
    <h1
      class="ty-headline-sm inline-block text-center bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
    >
      GAME-CHANGER BEI
    </h1>
  </div>
  <div
    class="absolute top-0 left-0 h-full w-[20vw] z-10 pointer-events-none bg-gradient-to-r from-back to-transparent"
  >
  </div>
  <div
    class="absolute top-0 right-0 h-full w-[20vw] z-10 pointer-events-none bg-gradient-to-l from-back to-transparent"
  >
  </div>
  <div class="relative overflow-hidden brightness-[0.8] dark:brightness-100">
    <div class="flex animate-marquee w-max py-12 px-4 marquee-container hover:pause-animation">
      <!-- First set of logos -->
      <div class="flex items-center gap-16 pl-20 justify-center h-[50px]">
        {
          companyLogos.map((logo) => (
            <div class="flex-shrink-0 group cursor-pointer h-full flex items-center">
              <img
                src={logo.src.src}
                alt={logo.alt}
                width={logo.width}
                height="50"
                style={`width: ${logo.width}px;`}
                class="transition-all duration-300 ease-in-out animate-blur h-auto object-contain"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>

      <!-- Duplicate set for seamless loop -->
      <div class="flex items-center gap-16 pl-20 justify-center h-[50px]">
        {
          companyLogos.map((logo) => (
            <div class="flex-shrink-0 group cursor-pointer h-full flex items-center">
              <img
                src={logo.src.src}
                alt={logo.alt}
                width={logo.width}
                height="50"
                style={`width: ${logo.width}px;`}
                class="transition-all duration-300 ease-in-out animate-blur h-auto object-contain"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>

      <!-- Duplicate set for seamless loop -->
      <div class="flex items-center gap-16 pl-20 justify-center h-[50px]">
        {
          companyLogos.map((logo) => (
            <div class="flex-shrink-0 group cursor-pointer h-full flex items-center">
              <img
                src={logo.src.src}
                alt={logo.alt}
                width={logo.width}
                height="50"
                style={`width: ${logo.width}px;`}
                class="transition-all duration-300 ease-in-out animate-blur h-auto object-contain"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  .animate-marquee {
    animation: marquee 20s linear infinite;
  }

  /* .pause-animation {
    animation-play-state: paused;
  }

  .marquee-container:hover {
    animation-play-state: paused;
  } */

  .animate-blur {
    filter: blur(0);
    transform: scale(1);
    transition:
      filter 0.5s ease,
      transform 0.5s ease;
  }

  .animate-blur:hover {
    transform: scale(1.15);
    animation: pulse-blur 1s ease;
  }

  @keyframes pulse-blur {
    0% {
      filter: blur(0);
    }
    50% {
      filter: blur(5px);
    }
    100% {
      filter: blur(0);
    }
  }

  /* Add this to handle the transition back smoothly */
  .animate-blur:not(:hover) {
    filter: blur(0);
    transition:
      filter 0.5s ease,
      transform 0.5s ease;
  }
</style>
