---
import { EarIcon, Grid2X2CheckIcon, LightbulbIcon, PackageIcon } from "lucide-react";

import { DotBackground } from "@/domains/home/DotBackground";
import { button } from "@/ui/Button";
import { BalanceScale } from "@/domains/home/BalanceScale";
---

<section id="wie-wir-arbeiten" class="overflow-hidden pt-20 relative flex flex-col bg-back">
  <div class="animate-blur-fade-in flex flex-col items-start max-w-7xl w-full mx-auto px-4">
    <h1
      class="text-4xl inline-block bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
    >
      So läuft unsere agile Zusammenarbeit
    </h1>
    <p class="text-lg mt-4 text-muted-front font-serif max-w-prose">
      Erfolgreiche Software entsteht in Zyklen, nicht in starren Phasen. Wir arbeiten agil – mit kurzen
      Iterationen, ständigem Feedback und kontinuierlicher Verbesserung. Jeder Zyklus bringt nutzbaren
      Fortschritt.
    </p>
  </div>

  <div class="max-w-7xl w-full relative mx-auto grid grid-cols-1 mt-10">
    <div class="px-8 absolute left-0 top-0 h-full flex items-center justify-center animate-blur-fade-in">
      <EarIcon size="48" className="text-primary-back opacity-0" strokeWidth="0.6" />

      <div class="absolute flex gap-2 w-[80%] bottom-[180px]">
        <div class="h-px w-full bg-neutral-700"></div>
        <div class="h-px w-full bg-neutral-700"></div>
        <div class="h-px w-full bg-neutral-700"></div>
        <div class="h-px w-full bg-neutral-700"></div>
        <div class="h-px w-full bg-neutral-700"></div>
        <div class="h-px w-full bg-neutral-700"></div>
        <div
          class="absolute whitespace-nowrap top-0 -right-4 translate-x-full -translate-y-1/2 text-muted-front tracking-widest"
        >
          NÄCHSTE ITERATION
        </div>
      </div>

      <div class="w-px absolute bg-border h-full z-0"></div>
      <div class="w-px absolute bg-gradient-to-b from-border to-front h-full z-0" id="timeline-line"></div>
    </div>

    <div class="animate-blur-fade-in relative z-10 flex gap-4 flex-1 px-4 py-10">
      <div class="flex flex-col items-start">
        <span class="text-4xl flex gap-4 items-center w-full">
          <div class="p-4 rounded-xl bg-back relative">
            <div class="absolute w-full h-full bg-primary-back/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <EarIcon size="48" className="text-primary-back relative" strokeWidth="0.6" />
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-front flex gap-1 items-center">Verstehen & Planen</h3>
        <p class="text-muted-front font-serif max-w-prose text-base mt-2">
          Wir hören zu, stellen die richtigen Fragen und priorisieren Anforderungen. Daraus entsteht ein
          klarer, kurzer Plan für die nächste Iteration.
        </p>
      </div>
    </div>

    <div class="animate-blur-fade-in relative z-10 flex gap-4 flex-1 px-4 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin flex gap-4 items-center justify-between w-full">
          <!-- 02. -->
          <div class="p-4 rounded-xl bg-back relative">
            <div class="absolute w-full h-full bg-primary-back/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <LightbulbIcon size="48" className="text-primary-back relative" strokeWidth="0.6" />
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-front flex gap-1 items-center">Entwickeln & Testen</h3>
        <p class="text-muted-front font-serif max-w-prose text-base mt-2">
          Wir setzen priorisierte Aufgaben um, in kleinen inkrementellen Schritten. Durch kontinuierliches
          Testen verringern wir technische Risiken früh.
        </p>
      </div>
    </div>

    <div class="animate-blur-fade-in relative z-10 flex gap-4 flex-1 px-4 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin block">
          <!-- 03. -->
          <div class="p-4 rounded-xl bg-back relative">
            <div class="absolute w-full h-full bg-primary-back/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <PackageIcon size="48" className="text-primary-back relative" strokeWidth="0.6" />
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-front flex gap-1 items-center">Ausliefern & Lernen</h3>
        <p class="text-muted-front font-serif max-w-prose text-base mt-2">
          Jede Iteration endet mit nutzbaren Ergebnissen. So hast du immer greifbare Fortschritte und konkrete
          Ansatzpunkte für die nächste Planung.
        </p>
      </div>
    </div>

    <div class="animate-blur-fade-in relative z-10 flex gap-4 flex-1 px-4 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin block">
          <!-- 04. -->
          <div class="p-4 rounded-xl bg-back relative">
            <div class="absolute w-full h-full bg-primary-back/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <Grid2X2CheckIcon size="48" className="text-primary-back relative" strokeWidth="0.6" />
          </div>
        </span>
      </div>

      <div>
        <h3 class="text-xl text-front flex gap-1 items-center">Optimieren & Weiterentwickeln</h3>
        <p class="text-muted-front font-serif max-w-prose text-base mt-2">
          Wir werten Nutzung und Feedback aus, identifizieren Verbesserungen und leiten konkrete Anpassungen
          für die nächste Planung ab.
        </p>
      </div>
    </div>

    <div class="animate-blur-fade-in relative z-10 flex gap-4 mt-4 flex-1 px-4 py-10">
      <div class="absolute bottom-0 left-0 z-10 bg-gradient-to-t from-back from-40% to-back/0 h-full w-full">
      </div>
      <div class="flex flex-col items-start">
        <span class="text-4xl flex gap-4 items-center w-full">
          <div class="p-4 rounded-xl bg-back relative">
            <div class="absolute w-full h-full bg-primary-back/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <EarIcon size="48" className="text-primary-back relative" strokeWidth="0.6" />
          </div>
        </span>
      </div>
      <div></div>
    </div>
  </div>
</section>

<section class="animate-blur-fade-in">
  <div class="relative container px-4 mx-auto mt-20 z-10">
    <div class="flex flex-col relative items-center py-20 px-4">
      <div
        class="absolute z-0 flex h-full w-full py-20 flex-col items-center justify-center rounded-xl left-1/2 top-1/2 -translate-1/2 opacity-50 pointer-events-none"
      >
        <DotBackground
          width={20}
          height={20}
          className="[mask-image:radial-gradient(300px_circle_at_center,white,transparent)]"
          client:load
        />
      </div>
      <BalanceScale className="animate-blur-fade-in" client:idle />
      <div class="flex justify-center relative">
        <div
          class="w-0 h-0 border-l-[30px] border-r-[30px] border-b-[40px] border-l-transparent border-r-transparent border-b-front"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="animate-blur-fade-in flex flex-col items-center justify-center px-4">
    <p class="text-lg mt-4 text-muted-front font-serif max-w-prose text-center">
      Nicht entweder–oder. Sondern genau richtig. Tempo hält Projekte lebendig, Qualität macht sie
      verlässlich. Wir setzen auf beides – in der passenden Dosis.
    </p>
  </div>
  <div class="animate-blur-fade-in text-center flex items-center justify-center px-4 my-10">
    <a
      href="#kontakt"
      class={button({
        size: "lg",
        class: "text-lg",
      })}>Kennenlern-Call vereinbaren</a
    >
  </div>
</section>

<script>
  import { animate, scroll } from "motion";

  const rotationElements = document.querySelectorAll(".rotation-element");

  if (rotationElements) {
    rotationElements.forEach((el) => {
      scroll(animate(el, { rotate: [0, -15, 15, 0] }), {
        target: rotationElements[0],
        offset: ["-3 0.5", "1 0.5"],
      });
    });
  }
  const timelineLine = document.getElementById("timeline-line");

  if (timelineLine) {
    scroll(animate(timelineLine, { scaleY: [0, 1], originX: 0, originY: 0 }), {
      target: timelineLine,

      offset: ["0 0.5", "1 0.5"],
    });
  }

  const scaleLine = document.getElementById("scale-line");

  if (scaleLine) {
    scroll(animate(scaleLine, { scaleY: [0, 1], originX: 0, originY: 0 }), {
      target: scaleLine,

      offset: ["0 0.7", "0 0.5"],
    });
  }
</script>
