---
import { EarIcon, Grid2X2CheckIcon, LightbulbIcon, PackageIcon } from "lucide-react";

import { DotBackground } from "@/domains/home/DotBackground";
import { button } from "@/ui/Button";
import { BalanceScale } from "@/domains/home/BalanceScale";
---

<section
  id="wie-wir-arbeiten"
  class="overflow-hidden py-20 relative animate-how-we-work opacity-0 flex flex-col bg-black"
>
  <div class="animate-how-we-work flex flex-col items-start max-w-7xl w-full mx-auto px-6">
    <h1
      class="text-4xl inline-block bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
    >
      So läuft unsere Zusammenarbeit
    </h1>
    <p class="text-lg mt-4 text-neutral-400 font-serif max-w-prose">
      Erfolgreiche Software entsteht nicht durch Zufall. Wir folgen einem klaren Rhythmus – von den ersten
      Zielen bis zum stabilen Betrieb. Das sorgt für Transparenz, Tempo und Verlässlichkeit.
    </p>
  </div>

  <div class="animate-how-we-work max-w-7xl w-full relative mx-auto mt-10 grid grid-cols-1">
    <div class="px-10 absolute left-0 top-0 h-full flex items-center justify-center">
      <EarIcon size="48" className="text-primary-500 opacity-0" strokeWidth="0.6" />

      <div class="w-px absolute bg-neutral-800 h-full"></div>
      <div class="w-px absolute bg-white h-full" id="timeline-line"></div>
    </div>
    <div class="animate-how-we-work relative z-10 flex gap-4 flex-1 px-6 py-10">
      <div class="flex flex-col items-start">
        <span class="text-4xl flex gap-4 items-center w-full">
          <div class="p-4 rounded-xl bg-black relative">
            <div class="absolute w-full h-full bg-primary-500/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <EarIcon size="48" className="text-primary-500 relative" strokeWidth="0.6" />
            <div class="absolute top-1.5 left-1.5 leading-none text-primary-500 text-xs">01</div>
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-white flex gap-1 items-center">Zuhören</h3>
        <p class="text-neutral-400 font-serif max-w-prose text-base mt-2">
          Wir hören zu, stellen die richtigen Fragen und schaffen Klarheit. Erst wenn wir deine Ziele
          verstanden haben, entscheiden wir über die Mittel.
        </p>
      </div>
    </div>

    <div class="animate-how-we-work relative z-10 flex gap-4 flex-1 px-6 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin flex gap-4 items-center justify-between w-full">
          <!-- 02. -->
          <div class="p-4 rounded-xl bg-black relative">
            <div class="absolute w-full h-full bg-primary-500/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <LightbulbIcon size="48" className="text-primary-500 relative" strokeWidth="0.6" />
            <div class="absolute top-1.5 left-1.5 leading-none text-primary-500 text-xs">02</div>
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-white flex gap-1 items-center">Mitdenken</h3>
        <p class="text-neutral-400 font-serif max-w-prose text-base mt-2">
          Wir hinterfragen Annahmen und kürzen Wege. Gute Lösungen wirken oft selbstverständlich – genau das
          ist die Kunst.
        </p>
      </div>
    </div>
    <div class="animate-how-we-work relative z-10 flex gap-4 flex-1 px-6 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin block">
          <!-- 03. -->
          <div class="p-4 rounded-xl bg-black relative">
            <div class="absolute w-full h-full bg-primary-500/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <PackageIcon size="48" className="text-primary-500 relative" strokeWidth="0.6" />
            <div class="absolute top-1.5 left-1.5 leading-none text-primary-500 text-xs">03</div>
          </div>
        </span>
      </div>
      <div>
        <h3 class="text-xl text-white flex gap-1 items-center">Liefern</h3>
        <p class="text-neutral-400 font-serif max-w-prose text-base mt-2">
          Kurze Zyklen, sichtbare Fortschritte – lieber jede Woche nutzbare Ergebnisse als späte
          Überraschungen.
        </p>
      </div>
    </div>

    <div class="animate-how-we-work relative z-10 flex gap-4 flex-1 px-6 py-10">
      <div class="flex flex-col items-start">
        <span class="text-7xl font-thin block">
          <!-- 04. -->
          <div class="p-4 rounded-xl bg-black relative">
            <div class="absolute w-full h-full bg-primary-500/20 rounded-[inherit] top-0 z-0 left-0"></div>
            <Grid2X2CheckIcon size="48" className="text-primary-500 relative" strokeWidth="0.6" />
            <div class="absolute top-1.5 left-1.5 leading-none text-primary-500 text-xs">04</div>
          </div>
        </span>
      </div>

      <div>
        <h3 class="text-xl text-white flex gap-1 items-center">Stabilisieren</h3>
        <p class="text-neutral-400 font-serif max-w-prose text-base mt-2">
          Wir beheben Fehler, räumen Stolpersteine aus und machen die Lösung robust. So hält sie dem Alltag
          und dem Wachstum stand.
        </p>
      </div>
    </div>
  </div>
</section>

<div class="animate-how-we-work relative container px-6 mx-auto mt-20 z-10">
  <div class="flex flex-col relative items-center py-20 px-4">
    <div
      class="absolute z-0 flex h-full w-full py-20 flex-col items-center justify-center rounded-xl left-1/2 top-1/2 -translate-1/2 opacity-50 pointer-events-none"
    >
      <DotBackground
        width={20}
        height={20}
        className="[mask-image:radial-gradient(300px_circle_at_center,white,transparent)]"
        client:load
      />
    </div>
    <BalanceScale client:idle />
    <div class="flex justify-center relative">
      <div
        class="w-0 h-0 border-l-[30px] border-r-[30px] border-b-[40px] border-l-transparent border-r-transparent border-b-white"
      >
      </div>
    </div>
  </div>
</div>
<div class="flex flex-col items-center justify-center px-6">
  <p class="text-lg mt-4 text-neutral-400 font-serif max-w-prose text-center">
    Nicht entweder–oder. Sondern genau richtig. Tempo hält Projekte lebendig, Qualität macht sie verlässlich.
    Wir setzen auf beides – in der passenden Dosis.
  </p>
</div>
<div class="animate-how-we-work text-center flex items-center justify-center px-6 mt-10">
  <a
    href="#kontakt"
    class={button({
      size: "lg",
      class: "text-lg",
    })}>Kennenlern-Call vereinbaren</a
  >
</div>

<script>
  import { animate, scroll } from "motion";

  const rotationElements = document.querySelectorAll(".rotation-element");

  if (rotationElements) {
    rotationElements.forEach((el) => {
      scroll(animate(el, { rotate: [0, -15, 15, 0] }), {
        target: rotationElements[0],
        offset: ["-3 0.5", "1 0.5"],
      });
    });
  }
  const timelineLine = document.getElementById("timeline-line");

  if (timelineLine) {
    scroll(animate(timelineLine, { scaleY: [0, 1], originX: 0, originY: 0 }), {
      target: timelineLine,

      offset: ["0 0.5", "1 0.5"],
    });
  }

  const scaleLine = document.getElementById("scale-line");

  if (scaleLine) {
    scroll(animate(scaleLine, { scaleY: [0, 1], originX: 0, originY: 0 }), {
      target: scaleLine,

      offset: ["0 0.7", "0 0.5"],
    });
  }
</script>

<script>
  import { animate, inView } from "motion";

  // Small helper that finds the meaningful pieces inside the section
  const animateEls = document.querySelectorAll(".animate-how-we-work");
  const section = animateEls[0];

  // If there are no elements, warn and exit early.
  if (!section || animateEls.length === 0) {
    console.warn("No elements with class 'animate-how-we-work' found.");
  } else {
    const elements = [...animateEls].filter(Boolean);

    // Use motion's inView helper to detect visibility and animate with a stagger
    inView(
      section,
      () => {
        elements.forEach((el, index) => {
          if (!el) return;
          animate(
            el,
            {
              opacity: [0, 1],
              y: [100, 0],
              filter: ["blur(20px)", "blur(0px)"],
            },
            {
              delay: (index || 0) * 0.18,
              duration: 0.55,
            }
          );
        });
      },
      { amount: 0.1 }
    );
  }
</script>
