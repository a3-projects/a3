  <div class="animate-how-we-work relative container px-6 mx-auto mt-20 z-10">
    <div class="flex flex-col relative items-center py-20 px-4">
      <div
        class="absolute z-0 flex h-full w-full py-20 flex-col items-center justify-center rounded-xl left-1/2 top-1/2 -translate-1/2 opacity-50 pointer-events-none"
      >
        <DotBackground
          width={20}
          height={20}
          className="[mask-image:radial-gradient(300px_circle_at_center,white,transparent)]"
          client:load
        />
      </div>
      <div class="relative w-full max-w-[550px]">
        <div
          class="relative flex items-between justify-between mb-4 rounded-2xl bg-gradient-to-r from-primary-500/50 via-black/0 to-secondary-500/50"
        >
          <div class="left-0 text-xl rounded-xl px-8 py-10">TEMPO</div>
          <div class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 h-[120%] w-px bg-white">
          </div>
          <div class="right-0 -top-6 text-xl rounded-xl px-8 py-10">SORGFALT</div>
        </div>

        <div class="flex justify-center">
          <div
            class="w-0 h-0 border-l-[50px] border-r-[50px] border-b-[20px] border-l-transparent border-r-transparent border-b-white"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="flex flex-col items-center justify-center">
    <!-- <h1
      class="text-4xl inline-block text-center bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
    >
      Nicht entweder–oder. Sondern genau richtig.
    </h1> -->

    <p class="text-lg mt-4 text-neutral-400 font-serif max-w-prose text-center">
      Nicht entweder–oder. Sondern genau richtig. Tempo hält Projekte lebendig, Sorgfalt macht sie
      verlässlich. Wir setzen auf beides – in der passenden Dosis.
    </p>
  </div>
  <div class="animate-how-we-work text-center flex items-center justify-center px-6">
    <a
      href="#kontakt"
      class={button({
        size: "lg",
      })}>Kennenlern-Call vereinbaren</a
    >
  </div>
</section>

<script>
  import { animate, inView } from "motion";

  // Small helper that finds the meaningful pieces inside the section
  const animateEls = document.querySelectorAll(".animate-how-we-work");
  const section = animateEls[0];

  // If there are no elements, warn and exit early.
  if (!section || animateEls.length === 0) {
    console.warn("No elements with class 'animate-how-we-work' found.");
  } else {
    const elements = [...animateEls].filter(Boolean);

    // Use motion's inView helper to detect visibility and animate with a stagger
    inView(
      section,
      () => {
        elements.forEach((el, index) => {
          if (!el) return;
          animate(
            el,
            {
              opacity: [0, 1],
              y: [100, 0],
              filter: ["blur(20px)", "blur(0px)"],
            },
            {
              delay: (index || 0) * 0.18,
              duration: 0.55,
            }
          );
        });
      },
      { amount: 0.2 }
    );
  }
</script>
