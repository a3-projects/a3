---
import { GradientHoverCard } from "@/domains/home/GradientHoverCard";
import shapes from "@/assets/images/pictures/shapes.jpg";
import development from "@/assets/images/pictures/development.jpg";

import { Image } from "astro:assets";
import { LogoOutline } from "@/ui/icons/LogoOutline";
import { CheckIcon, SettingsIcon, MoreHorizontalIcon } from "lucide-react";
import { Logo } from "@/ui/icons/Logo";
import { button } from "@/ui/Button";
import { OrbitingTools } from "@/domains/home/OrbitingTools";
---

<section class="container w-full px-4 py-40 mx-auto bg-back min-h-[600px] flex relative">
  <div
    class="absolute w-[60%] h-[60%] rounded-full left-1/2 top-1/2 -translate-1/2 bg-primary-600/20 blur-[100px] z-0"
  >
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.5fr_1fr] gap-4 relative max-w-[1400px]">
    <div class="grid grid-rows-[2fr_1fr] gap-4">
      <div class="grid grid-cols-[2fr_1fr] gap-4 w-full flex-grow-1">
        <div class="grid">
          <GradientHoverCard
            client:idle
            id="web-apps-card"
            className="animate-blur-fade-in overflow-hidden backdrop-blur-xl rounded-xl border border-primary-500/50 bg-primary-500/20 flex-grow-1"
          >
            <div class="px-4 pt-4">
              <h2
                class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
              >
                Web-Apps
              </h2>
              <p class="ty-body-md text-muted-front">Desktop & Mobile-friendly</p>
            </div>

            <div
              class="w-full absolute -right-[50px] -bottom-[20px] group-hover:scale-110 -rotate-5 group-hover:rotate-0 group-hover:-translate-[20px] transition-spring"
            >
              <div
                class="border-6 rounded-xl border-neutral-950 flex flex-col relative bg-neutral-950 h-[200px] overflow-hidden"
              >
                <Logo
                  className="absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-[calc(50%_+_30px)] text-back/20 flex-grow-1  w-[200%] "
                />
                <div class="w-full overflow-hidden relative bg-neutral-950 flex items-start gap-1 px-1 py-2">
                  <div class="w-[8px] h-[8px] rounded-full bg-destructive-back/50"></div>
                  <div class="w-[8px] h-[8px] rounded-full bg-warn-back/50"></div>

                  <div class="w-[8px] h-[8px] rounded-full bg-primary-back/50"></div>
                </div>
                <div class="w-full h-full bg-gradient-to-b from-primary-500 to-primary-500/0"></div>
              </div>
            </div>

            <div
              class="w-[120px] absolute right-[20px] -bottom-[40px] group-hover:scale-110 rotate-5 group-hover:rotate-0 group-hover:-translate-[10px] transition-spring"
            >
              <div
                class="rounded-xl relative border-6 border-neutral-950 bg-neutral-950 h-[150px] overflow-hidden"
              >
                <Logo
                  className="absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-[calc(50%_+_50px)] text-back/20 flex-grow-1  w-[300%] "
                />
                <div class="w-full overflow-hidden relative bg-neutral-950 flex items-start gap-1 px-1 py-2">
                  <div class="w-[8px] h-[8px] rounded-full bg-destructive-back/50"></div>
                  <div class="w-[8px] h-[8px] rounded-full bg-warn-back/50"></div>

                  <div class="w-[8px] h-[8px] rounded-full bg-primary-back/50"></div>
                </div>
                <div class="w-full h-full bg-gradient-to-b from-primary-500 to-55% to-primary-500/0"></div>
              </div>
            </div>
          </GradientHoverCard>
        </div>
        <div class="grid grid-rows-[2fr_1fr] gap-4">
          <GradientHoverCard
            client:idle
            className="animate-blur-fade-in group backdrop-blur-xl rounded-xl bg-primary-500/10 overflow-hidden"
          >
            <div class="w-full h-full">
              <Image
                src={development}
                class="object-cover w-full h-full group-hover:scale-110 transition-spring"
                alt="Development"
                width="400"
                loading="lazy"
              />
            </div>
          </GradientHoverCard>
          <div class="flex">
            <GradientHoverCard
              client:idle
              className="animate-blur-fade-in group-hover backdrop-blur-xl relative rounded-xl border border-border p-4 bg-back/30 flex  w-full h-full overflow-hidden"
            >
              <div class="w-full h-full flex items-center justify-center">
                <h2
                  class="ty-headline-xl absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 scale-0 blur-xl group-hover:blur-none group-hover:scale-150 group-hover:opacity-100 transition-spring"
                >
                  A3
                </h2>
              </div>
              <LogoOutline
                className="absolute flex top-1/2 left-1/2 -translate-x-1/2 translate-y-[-60%] text-front group-hover:text-primary-500 group-hover:blur-xl group-hover:opacity-0 flex-grow-1 w-[200%] group-hover:scale-50 transition-spring"
              />
              <LogoOutline
                className="absolute hidden dark:flex top-1/2 left-1/2 -translate-x-1/2 translate-y-[-60%] text-front group-hover:text-primary-500 group-hover:opacity-0 blur-lg flex-grow-1 w-[200%] group-hover:scale-50 transition-spring"
              />
            </GradientHoverCard>
          </div>
        </div>
      </div>
      <div class="flex">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl flex-grow-1 border border-border bg-back/30"
        >
          <div class="px-4 pt-4">
            <h2
              class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
            >
              Infrastruktur-Automatisierung
            </h2>
            <p class="ty-body-md text-muted-front">Skalierbarkeit & Pipelines</p>
          </div>
          <div
            class="flex items-center mt-4 pb-10 -translate-x-12 group-hover:translate-x-0 transition-spring"
          >
            <div class="h-[1px] w-2 bg-primary-back"></div>
            <div
              class="w-8 h-8 rounded-full bg-primary-back border border-primary-back flex items-center justify-center"
            >
              <CheckIcon className="text-primary-front w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-primary-back"></div>
            <div
              class="w-8 h-8 rounded-full bg-primary-back border border-primary-back flex items-center justify-center"
            >
              <CheckIcon className="text-primary-front w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-primary-back"></div>
            <div
              class="w-8 h-8 rounded-full bg-primary-back border border-primary-back flex items-center justify-center"
            >
              <CheckIcon className="text-primary-front w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-primary-back"></div>
            <div
              class="w-12 h-12 rounded-full bg-neutral-back/20 border border-neutral-back flex items-center justify-center"
            >
              <MoreHorizontalIcon className="text-front w-6 h-4" strokeWidth={2} />
            </div>
            <div class="flex gap-1 mx-1">
              <div class="h-[1px] w-2 bg-neutral-back"></div>
              <div class="h-[1px] w-2 bg-neutral-back"></div>
              <div class="h-[1px] w-2 bg-neutral-back"></div>
            </div>
          </div>
        </GradientHoverCard>
      </div>
    </div>
    <div class="grid grid-cols-[1fr_2fr] lg:grid-cols-1 min-h-[300px] lg:grid-rows-[1fr_2fr] gap-4">
      <div class="flex flex-grow-1">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl border border-border bg-back/30 w-full"
        >
          <div class="px-4 pt-4 pb-20 relative z-10">
            <h2
              class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
            >
              UI / UX Design
            </h2>
            <p class="ty-body-md text-muted-front">Intuitiv & Ansprechend</p>
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[200%] aspect-square inset-0 bg-primary-500/20 transition-spring rounded-full"
          >
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[200%] aspect-square -translate-y-3/4 -translate-x-1/3 inset-0 bg-primary-500/20 group-hover:delay-300 transition-spring rounded-full"
          >
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[400%] aspect-square -translate-y-1/4 -translate-x-3/4 inset-0 bg-primary-500/20 group-hover:delay-600 transition-spring rounded-full"
          >
          </div>
        </GradientHoverCard>
      </div>
      <div class="flex flex-grow-2">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl flex-grow-1 border border-primary-500/50 bg-primary-500/10 "
        >
          <div class="px-4 pt-4 pb-20 relative z-10">
            <h2
              class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
            >
              Code-Analyse
            </h2>
            <p class="ty-body-md text-muted-front">Qualität & Struktur</p>
          </div>

          <div
            class="font-mono opacity-50 lg:opacity-100 ty-body-md absolute bottom-0 right-0 translate-x-12 pl-4 group-hover:scale-120 transition-spring"
          >
            <div class="flex gap-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-50 group-hover:blur-none transition-spring"
              >
                def
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-100 group-hover:blur-none transition-spring"
              >
                fizzbuzz():
              </div>
            </div>

            <div class="pl-2 flex gap-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-150 group-hover:blur-none transition-spring"
              >
                for
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-200 group-hover:blur-none transition-spring"
              >
                i
              </div>
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-250 group-hover:blur-none transition-spring"
              >
                in
              </div>

              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-300 group-hover:blur-none transition-spring"
              >
                <span class="text-primary-500">range</span>(1,101):
              </div>
            </div>

            <div class="pl-4 flex gap-2">
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-350 group-hover:blur-none transition-spring"
              >
                print_number
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-400 group-hover:blur-none transition-spring"
              >
                =
              </div>

              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-450 group-hover:blur-none transition-spring"
              >
                true
              </div>
            </div>

            <div class="flex gap-2 pl-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-500 group-hover:blur-none transition-spring"
              >
                if
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-550 group-hover:blur-none transition-spring"
              >
                i
              </div>

              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-650 group-hover:blur-none transition-spring"
              >
                is
              </div>
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] group-hover:delay-700 group-hover:blur-none transition-spring"
              >
                divisibleBy
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-750 group-hover:blur-none transition-spring"
              >
                3:
              </div>
            </div>

            <div class="flex gap-2 pl-4">
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-800 group-hover:blur-none transition-spring"
              >
                print
              </div>
              <div
                class="relative inline-block lg:blur-[4px] group-hover:delay-850 group-hover:blur-none transition-spring"
              >
                "Fizz"
              </div>
            </div>
          </div>
        </GradientHoverCard>
      </div>
    </div>
    <div class="grid grid-rows-[0.3fr_1fr] gap-4 min-h-[600px]">
      <div class="flex gap-4">
        <div class="flex flex-grow-1">
          <GradientHoverCard
            client:idle
            className="animate-blur-fade-in backdrop-blur-xl rounded-xl border border-primary-500/50 bg-primary-500/10 w-full overflow-hidden relative"
          >
            <div class="px-4 pt-4 pb-20">
              <h2
                class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
              >
                Prozessoptimierung
              </h2>
              <p class="ty-body-md text-muted-front">Effizienz & Kontrolle</p>
            </div>
            <SettingsIcon
              className="absolute w-60 h-60 text-primary-500/50 fill-primary-500/10 top-1/2 right-0 translate-x-1/2 -translate-y-1/4 group-hover:rotate-[180deg] transition-spring"
              strokeWidth={0.1}
            />
          </GradientHoverCard>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="grid grid-rows-[0.5fr_1fr] gap-4">
          <div class="animate-blur-fade-in flex flex-grow-1 group relative overflow-hidden">
            <a
              href="#kontakt"
              class={button({
                class: "ty-headline-md w-full h-full p-4 text-center relative z-0 rounded-xl",
              })}
            >
              <span class="relative z-10"> Projekt anfragen </span>

              <div
                class="absolute top-1/2 left-1/2 -translate-1/2 h-[120%] w-1/3 -skew-x-[30deg] bg-back/20 pointer-events-none group-hover:scale-[3] transition-spring"
              >
              </div>
            </a>
          </div>

          <div class="animate-blur-fade-in w-full h-full group relative rounded-xl overflow-hidden">
            <Image
              src={shapes}
              class="absolute object-cover w-full h-full group-hover:scale-110 transition-spring"
              alt="Shapes"
              width="400"
              fit="cover"
              loading="lazy"
              position="top"
            />
            <div class="absolute bg-back/20 w-full h-full top-0 left-0"></div>
          </div>
        </div>
        <div class="grid grid-rows-[1fr_0.5fr] gap-4">
          <div class="flex">
            <GradientHoverCard
              client:idle
              className="animate-blur-fade-in group backdrop-blur-xl relative rounded-xl border border-border  bg-back/30 flex  w-full h-full overflow-hidden"
            >
              <div
                class="absolute top-1/2 left-1/2 -translate-1/2 w-full h-full flex gap-4 flex-wrap max-w-7xl align-center justify-center"
              >
                <div
                  class="relative h-[700px] w-full flex items-center justify-center lg:grayscale group-hover:grayscale-0 group-hover:scale-110 transition-spring"
                >
                  <OrbitingTools client:idle />
                </div>
              </div>
            </GradientHoverCard>
          </div>
          <div class="animate-blur-fade-in flex flex-grow-1">
            <div class="backdrop-blur-sm flex items-end justify-end rounded-xl flex-grow-1 bg-back/20 p-4">
              <h2
                class="ty-headline-sm bg-gradient-to-br from-front via-front to-neutral-back text-transparent bg-clip-text"
              >
                Und mehr...
              </h2>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
