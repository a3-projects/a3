---
import { Logo } from "@/ui/icons/Logo";
import { TextHighlight } from "@/ui/TextHighlight";
import { GradientHoverCard } from "@/domains/home/GradientHoverCard";
import { DotBackground } from "@/domains/home/DotBackground";
import { button } from "@/ui/Button";
import { Container } from "@/domains/home/Container";
import { DotsBackground } from "@/domains/home/DotsBackground";
---

<section id="was-wir-bewirken" class="overflow-hidden z-10 relative border-t border-border flex flex-col">
  <div class="py-20 relative">
    <div
      class="absolute border-border top-0 left-1/2 -translate-x-1/2 pointer-events-none border-l border-dashed w-[calc(100%_+_4rem)] h-full"
    >
    </div>

    <div
      class="absolute border-border top-0 left-1/2 -translate-x-1/2 pointer-events-none border-r border-dashed w-[calc(100%_+_8rem)] h-full"
    >
    </div>

    <div class="z-10 w-full relative">
      <Container>
        <h2
          class="animate-blur-fade-in text-4xl inline-block bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
        >
          Software, die nicht bremst – <br />sondern dein Business voranbringt.
        </h2>
      </Container>

      <Container>
        <p class="animate-blur-fade-in max-w-7xl text-lg mt-4 text-muted-front font-serif">
          Viele Unternehmen kämpfen mit Tools und Anwendungen, die kompliziert sind, Zeit fressen oder nicht
          mitwachsen. Wir entwickeln Software, die spürbar entlastet und echten ROI bringt.
        </p>
      </Container>
    </div>
    <Container className="px-6 z-10 mt-10">
      <p class="animate-blur-fade-in font-serif text-lg text-muted-front">Was wir für dich bewirken:</p>

      <div class="grid grid-cols-1 mt-4 md:grid-cols-3 gap-4 auto-template-columns-[300px]">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="text-xl text-front">Mehr zahlende Kunden</h3>
            </div>
            <p class="text-muted-front font-serif">
              <TextHighlight>Intuitive, ansprechende Anwendungen</TextHighlight>, die Nutzer begeistern – und
              sie gerne wiederkommen lassen.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10  backdrop-blur-sm border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="text-xl text-front">Mehr Fokus im Alltag</h3>
            </div>
            <p class="text-muted-front font-serif">
              <TextHighlight>Intelligente Automatisierung</TextHighlight> nimmt Routineaufgaben ab und schafft
              Raum für Strategie und Kreativität.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="text-xl text-front">Zufriedene Mitarbeiter</h3>
            </div>
            <p class="text-muted-front font-serif flex-grow">
              <TextHighlight>Durchdachte Tools</TextHighlight> vereinfachen komplexe Abläufe – Frust sinkt, Motivation
              steigt.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="text-xl text-front">Nachhaltiges Wachstum</h3>
            </div>
            <p class="text-muted-front font-serif">
              Fundament für morgen – <TextHighlight>Architektur</TextHighlight>, die mit deinem Business
              skaliert.
            </p>
          </div>
        </GradientHoverCard>

        <div
          class="hidden lg:flex animate-blur-fade-in relative rounded-xl p-8 items-center justify-center w-full aspect-square md:aspect-auto"
        >
          <div class="absolute flex inset-0">
            <DotBackground
              client:idle
              width={16}
              height={16}
              className="[mask-image:radial-gradient(220px_circle_at_center,white,transparent)]"
            />
          </div>

          <div class="flex absolute w-full h-full -translate-y-2 translate-x-2">
            <Logo
              className="hidden dark:flex text-front/50 blur-xl m-auto  transition-colors duration-300 z-0"
              size="70%"
            />
          </div>
          <div class="absolute flex w-full h-full -translate-y-2 translate-x-2">
            <Logo className="text-front m-auto " size="70%" />
          </div>
        </div>
        <!-- Card 6: Energie für Innovation -->
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <!-- <div class="icon-wrapper">
              <LightbulbIcon className="w-8 h-8 text-primary-400" strokeWidth={1.5} />
            </div> -->
              <h3 class="text-xl text-front">Energie für Innovation</h3>
            </div>
            <p class="text-muted-front font-serif">
              <TextHighlight>Reibungslose Abläufe</TextHighlight> lassen Ideen entstehen – statt ständig Feuer
              löschen.
            </p>
          </div>
        </GradientHoverCard>
      </div>
    </Container>
    <div class="animate-blur-fade-in text-center flex items-center justify-center px-6 mt-20">
      <a
        href="#kontakt"
        class={button({
          size: "lg",
          class: "text-lg",
        })}>Kennenlern-Call vereinbaren</a
      >
    </div>
  </div>
</section>
