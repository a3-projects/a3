---
import { Logo } from "@/ui/icons/Logo";
import { TextHighlight } from "@/ui/TextHighlight";
import { GradientHoverCard } from "@/domains/home/GradientHoverCard";
import { DotBackground } from "@/domains/home/DotBackground";
import { button } from "@/ui/Button";
import { Container } from "@/domains/home/Container";
import { DotsBackground } from "@/domains/home/DotsBackground";
---

<section id="was-wir-bewirken" class="overflow-hidden z-10 relative border-t border-border flex flex-col">
  <div class="py-20 relative">
    <div
      class="absolute border-border top-0 left-1/2 -translate-x-1/2 pointer-events-none border-l border-dashed w-[calc(100%_+_4rem)] h-full"
    >
    </div>

    <div
      class="absolute border-border top-0 left-1/2 -translate-x-1/2 pointer-events-none border-r border-dashed w-[calc(100%_+_8rem)] h-full"
    >
    </div>

    <div class="z-10 w-full relative">
      <Container>
        <h2
          class="animate-blur-fade-in ty-headline-lg inline-block bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
        >
          Warum der MVP-Sprint funktioniert
        </h2>
      </Container>

      <Container>
        <p class="animate-blur-fade-in ty-subtitle-lg text-muted-front mt-4 max-w-7xl">
          <TextHighlight>80% der Nutzer verwenden nur 20% der Funktionen.</TextHighlight> Ein MVP zwingt zur Priorisierung.
          Genau das macht den Unterschied zwischen <TextHighlight>Erfolg und teurem Scheitern.</TextHighlight>
        </p>
      </Container>
    </div>
    <Container className="px-6 z-10 mt-10">
      <p class="animate-blur-fade-in ty-subtitle-lg text-muted-front">Das bekommst du mit dem MVP-Sprint:</p>

      <div class="grid grid-cols-1 mt-4 md:grid-cols-3 gap-4 auto-template-columns-[300px]">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="ty-headline-sm text-front">Schnelle Validierung</h3>
            </div>
            <p class="ty-body-md text-muted-front">
              Markteintritt in <TextHighlight>Wochen statt Monaten</TextHighlight>. Ein echter Prototyp, den
              du testen und zeigen kannst. Deine Entscheidungen basieren auf echtem Nutzerfeedback, nicht
              Bauchgefühl.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10  backdrop-blur-sm border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="ty-headline-sm text-front">80% weniger Startkosten</h3>
            </div>
            <p class="ty-body-md text-muted-front">
              <TextHighlight>Festpreis, nur 5.000 €</TextHighlight>. MVP heißt Fokus auf das Wesentliche. Kein
              Geld für Features, die niemand braucht. Marktfeedback vor der großen Investition.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="ty-headline-sm text-front">Echte Kommunikation</h3>
            </div>
            <p class="ty-body-md text-muted-front flex-grow">
              <TextHighlight>Tägliche Updates</TextHighlight>, direkte Ansprechpartner, keine Blackbox. Du
              siehst jeden Tag, was passiert und kannst jederzeit Feedback geben.
            </p>
          </div>
        </GradientHoverCard>

        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="ty-headline-sm text-front">Kein Lock-in</h3>
            </div>
            <p class="ty-body-md text-muted-front">
              Nach 14 Tagen entscheidest du frei. Passt es? Weitermachen. Passt es nicht? Kein Problem.
              <TextHighlight>Du behältst den Code</TextHighlight> – immer.
            </p>
          </div>
        </GradientHoverCard>

        <div
          class="hidden lg:flex animate-blur-fade-in relative rounded-xl p-8 items-center justify-center w-full aspect-square md:aspect-auto"
        >
          <div class="absolute flex inset-0">
            <DotBackground
              client:idle
              width={16}
              height={16}
              className="[mask-image:radial-gradient(220px_circle_at_center,white,transparent)]"
            />
          </div>

          <div class="flex absolute w-full h-full -translate-y-2 translate-x-2">
            <Logo
              className="hidden dark:flex text-front/50 blur-xl m-auto  transition-colors duration-300 z-0"
              size="70%"
            />
          </div>
          <div class="absolute flex w-full h-full -translate-y-2 translate-x-2">
            <Logo className="text-front m-auto " size="70%" />
          </div>
        </div>
        <!-- Card 6: Energie für Innovation -->
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in relative z-10 backdrop-blur-sm overflow-hidden border border-border rounded-xl"
        >
          <DotsBackground color="border" />

          <div class="flex flex-col h-full p-6 relative">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="ty-headline-sm text-front">Drei Experten, ein Ziel</h3>
            </div>
            <p class="ty-body-md text-muted-front">
              Das <TextHighlight>komplette A3 Team</TextHighlight> arbeitet an deinem Projekt. Frontend, Backend,
              Infrastruktur: alles aus einer Hand, keine Koordinationsprobleme.
            </p>
          </div>
        </GradientHoverCard>
      </div>
    </Container>
    <div class="animate-blur-fade-in text-center flex items-center justify-center px-6 mt-20">
      <a
        href="#kontakt"
        class={button({
          size: "lg",
        })}>Projekt anfragen</a
      >
    </div>
  </div>
</section>
