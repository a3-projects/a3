---
import { button } from "@/ui/Button";
import LogoBackground from "@/domains/home/LogoBackground";
import { Container } from "@/domains/home/Container";
---

<script>
  import { animate, scroll } from "motion";

  const fadeOutUp = (selector: string) => {
    const element = document.querySelector(selector);
    if (element) {
      scroll(animate(element, { y: [0, -200], opacity: [1, 0] }), {
        target: element,
        offset: ["0 0.1", "0.5 0"],
      });
    }
  };
  fadeOutUp("#hero-body");

  const heroBackground = document.querySelector("#hero-background");
  if (heroBackground) {
    scroll(animate(heroBackground, { x: [0, 1000], scale: [1, 2] }), {
      target: heroBackground,
      offset: ["0 0", "1 0"],
    });
  }
</script>
<div class="absolute h-[100vh] -mt-header w-full overflow-hidden">
  <LogoBackground id="hero-background" className="w-full h-full object-cover overflow-hidden" />
</div>

<section
  id="start"
  class="relative flex w-full h-full items-center pb-40 px-md-20 pt-10 min-h-[calc(100vh-theme('spacing.header'))] overflow-x-clip"
>
  <div aria-hidden="true" class="-z-0 flex gap-12 absolute left-0 h-[300%] transform rotate-30 -mt-20">
    <div class="w-[1px] h-full bg-border"></div>
    <div class="w-[1px] h-full bg-border"></div>
  </div>
  <Container className="z-10 h-full gap-24 flex-grow items-center px-4">
    <div id="hero-body" class="flex flex-col items-center justify-center text-center">
      <h1 id="hero-title" class="font-sans text-7xl text-primary-900 dark:text-primary-200 mt-4">
        <span
          class="bg-gradient-to-br from-primary-900 to-primary-back dark:from-primary-200 dark:via-primary-200 text-transparent bg-clip-text"
          >Drei Köpfe.</span
        >
        <span class="block md:inline">
          Ein <span
            class="bg-gradient-to-r from-primary-900 to-primary-back dark:from-primary-200 dark:via-primary-200 text-transparent bg-clip-text animate-pulse"
          >
            Puls
          </span>.</span
        >
      </h1>

      <p id="hero-description" class="text-xl max-w-[800px] pt-8">
        Verwandt im echten Leben, eingespielt im Projekt – drei Entwickler, die Klartext sprechen und echten
        Mehrwert schaffen.
      </p>
      <div id="hero-button" class="mt-14">
        <a
          href="#kontakt"
          class={button({
            size: "lg",
            class: "text-lg",
            increaseHitbox: true,
          })}>Kurzer Kennenlern-Call</a
        >
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 mt-14">
        <div
          class="border border-solid border-border bg-back/80 backdrop-blur-lg rounded-full px-4 py-2 text-front"
        >
          Pragmatisch
        </div>
        <div
          class="border border-solid border-border bg-back/80 backdrop-blur-lg rounded-full px-4 py-2 text-front"
        >
          Qualitätsbewusst
        </div>
        <div
          class="border border-solid border-border bg-back/80 backdrop-blur-lg rounded-full px-4 py-2 text-front"
        >
          Kommunikativ
        </div>
        <div
          class="border border-solid border-border bg-back/80 backdrop-blur-lg rounded-full px-4 py-2 text-front"
        >
          Verlässlich
        </div>
      </div>
    </div>
  </Container>
</section>
