<script>
  import { inView } from "motion";

  const setupAnimations = () => {
    const animateEls = document.querySelectorAll(".animate-blur-fade-in");

    if (animateEls.length > 0) {
      const elements = [...animateEls].filter(Boolean);

      elements.forEach((el) => {
        if (!el) return;
        inView(
          el,
          () => {
            el.setAttribute("data-in-view", "true");
          },
          { amount: 0.2 }
        );
      });
    }
  };

  // Use requestIdleCallback to wait until browser is idle (after hydration)
  if ("requestIdleCallback" in window) {
    requestIdleCallback(setupAnimations);
  } else {
    setTimeout(setupAnimations, 200);
  }
</script>

<style is:global>
  .animate-blur-fade-in {
    opacity: 0;
    filter: blur(20px);
    transition:
      opacity 0.5s ease-out,
      filter 0.5s ease-out;
  }

  .animate-blur-fade-in[data-in-view="true"] {
    opacity: 1;
    filter: blur(0);
  }
</style>
