<script>
  import { animate, inView } from "motion";

  // Small helper that finds the meaningful pieces inside the section
  const animateEls = document.querySelectorAll(".animate-blur-fade-in");

  // If there are no elements, warn and exit early.
  if (animateEls.length > 0) {
    const elements = [...animateEls].filter(Boolean);

    elements.forEach((el) => {
      if (!el) return;
      inView(
        el,
        () => {
          animate(
            el,
            {
              opacity: [0, 1],
              filter: ["blur(20px)", "blur(0px)"],
            },
            {
              duration: 0.55,
            }
          );
        },
        { amount: 0.2 }
      );
    });
  }
</script>

<style is:global>
  .animate-blur-fade-in {
    opacity: 0;
  }
</style>
