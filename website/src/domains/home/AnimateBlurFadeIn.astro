<script>
  import { inView } from "motion";

  const animateEls = document.querySelectorAll(".animate-blur-fade-in");

  if (animateEls.length > 0) {
    const elements = [...animateEls].filter(Boolean);

    elements.forEach((el) => {
      if (!el) return;
      inView(
        el,
        () => {
          el.classList.add("!transition-all", "!duration-500", "!blur-none", "!opacity-100");
        },
        { amount: 0.2 }
      );
    });
  }
</script>

<style is:global>
  .animate-blur-fade-in {
    opacity: 0;
    filter: blur(20px);
  }
</style>
