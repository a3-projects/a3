---
import { FAQAccordion } from "@/domains/home/FAQAccordion";
---

<section id="faq-section" class="overflow-hidden py-20 relative flex flex-col bg-back">
  <div class="flex flex-col items-center justify-center z-10 mb-16l px-6">
    <h2
      class="animate-blur-fade-in text-4xl inline-block text-center bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
    >
      Häufige Fragen
    </h2>
    <p class="animate-blur-fade-in text-lg mt-4 text-muted-front font-serif text-center max-w-2x">
      Klare Antworten auf die wichtigsten Fragen zur Zusammenarbeit mit uns.
    </p>
  </div>

  <div class="mx-auto w-full px-4 max-w-4xl z-20 mt-10">
    <FAQAccordion client:idle />
  </div>
</section>
