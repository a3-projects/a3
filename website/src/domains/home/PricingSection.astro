---
import { CheckIcon, RocketIcon, PackageIcon, HeartHandshakeIcon } from "lucide-react";
import { button } from "@/ui/Button";
import { DotsBackground } from "@/domains/home/DotsBackground";
---

<section id="preise" class="py-20">
  <div class="mx-auto px-4 max-w-5xl">
    <div class="text-center mb-8">
      <h2
        class="ty-headline-lg inline-block bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text animate-blur-fade-in"
      >
        Unsere Preismodelle
      </h2>
      <p class="ty-subtitle-lg text-muted-front mt-4 max-w-prose mx-auto animate-blur-fade-in">
        Erst beweisen, dann vertrauen. Drei Phasen – du entscheidest nach jeder.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr_1fr] items-start gap-6 mt-20">
      <!-- MVP-Sprint (Primary) -->
      <article
        class="relative bg-gradient-to-tr from-primary-back via-border to-border p-[1px] rounded-xl hover:shadow-lg transition-shadow duration-200 animate-blur-fade-in"
      >
        <div
          class="py-10 overflow-hidden relative px-6 bg-back rounded-xl w-full h-full flex flex-col justify-between"
        >
          <DotsBackground cornerOnly color="primary" />
          <div class="absolute w-full h-full overflow-hidden top-0 left-0 rounded-xl pointer-events-none">
            <div
              class="pointer-events-none z-0 absolute -left-20 -bottom-20 w-56 h-56 rounded-full bg-primary-back/80 blur-3xl opacity-40"
            >
            </div>
          </div>
          <div class="relative">
            <div class="mb-4 flex flex-col items-start gap-4">
              <div class="flex items-center gap-2">
                <RocketIcon size={36} className="shrink-0" />
                <span
                  class="bg-primary-back backdrop-blur-sm rounded-full text-primary-front px-2 ty-label-sm"
                  >Empfohlen zum Einstieg
                </span>
              </div>
              <div>
                <h3 class="ty-headline-xs text-front">MVP-Sprint</h3>
                <p class="ty-headline-lg text-front my-8">5.000 €</p>
                <p class="ty-body-sm text-muted-front mt-1">14 Tage, Festpreis</p>
              </div>
            </div>

            <ul class="list-none relative space-y-3 mb-4 ty-body-sm text-muted-front">
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Funktionierender MVP/Prototyp
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Tägliche Kommunikation
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Volle Team-Kapazität (3 Experten)
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Keine versteckten Kosten
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Kein Lock-in danach
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Du behältst den Code
              </li>
            </ul>
          </div>
          <div class="mt-4">
            <a
              href="#kontakt"
              class={button({
                size: "lg",
                className: "w-full",
              })}>Projekt anfragen</a
            >
          </div>
        </div>
      </article>

      <!-- Feature-Entwicklung -->
      <article
        class="relative bg-back rounded-xl border border-border hover:shadow-lg transition-shadow duration-200 animate-blur-fade-in"
      >
        <div
          class="px-6 py-10 bg-back rounded-xl w-full h-full flex flex-col justify-between relative overflow-hidden"
        >
          <DotsBackground cornerOnly color="border" />

          <div class="relative">
            <div class="mb-4 flex flex-col items-start gap-4">
              <PackageIcon size={36} className="shrink-0" />
              <div>
                <h3 class="ty-headline-xs text-front">Feature</h3>
                <p class="ty-body-sm text-muted-front mt-1">Individuell kalkuliert</p>
              </div>
            </div>

            <ul class="list-none space-y-3 mb-4 ty-body-sm text-muted-front">
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Aufbauend auf deinem MVP oder existierendem
                Produkt
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Klare Feature-Pakete
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Transparente Kalkulation
              </li>
            </ul>
          </div>
          <div class="mt-4">
            <a
              href="#kontakt"
              class={button({
                size: "lg",
                variant: "neutral",
                className: "w-full",
              })}>Projekt anfragen</a
            >
          </div>
        </div>
      </article>

      <!-- Partnerschaft -->
      <article
        class="relative bg-back rounded-xl border border-border hover:shadow-lg transition-shadow duration-200 animate-blur-fade-in"
      >
        <div
          class="px-6 py-10 bg-back rounded-xl w-full h-full flex flex-col justify-between relative overflow-hidden"
        >
          <DotsBackground cornerOnly color="border" />

          <div class="relative">
            <div class="mb-4 flex flex-col items-start gap-4">
              <HeartHandshakeIcon size={36} className="shrink-0" />
              <div>
                <h3 class="ty-headline-xs text-front">Partnerschaft</h3>
                <p class="ty-body-sm text-muted-front mt-1">Laufende Zusammenarbeit</p>
              </div>
            </div>

            <ul class="list-none space-y-3 mb-4 ty-body-sm text-muted-front">
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Langfristige Betreuung
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Flexibles Engagement
              </li>
              <li class="flex items-start gap-3">
                <CheckIcon size={20} className="shrink-0 mt-0.5" />Wartung & Support
              </li>
            </ul>
          </div>
          <div class="mt-4">
            <a
              href="#kontakt"
              class={button({
                size: "lg",
                variant: "neutral",
                className: "w-full",
              })}>Projekt anfragen</a
            >
          </div>
        </div>
      </article>
    </div>

    <div class="py-6 animate-blur-fade-in">
      <h3 class="ty-headline-sm text-front mb-2">Unser Modell: Erst beweisen, dann vertrauen</h3>
      <p class="ty-body-md text-muted-front">
        Ein MVP ist kein unfertiges Produkt – es ist die intelligenteste Art, ein Produkt zu starten. Du
        siehst, wie wir arbeiten, bekommst echtes Marktfeedback und entscheidest dann, ob du weitermachen
        willst. Kein Risiko, keine langen Verträge.
      </p>
    </div>
  </div>
</section>
