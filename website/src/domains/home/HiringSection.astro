<script>
  import { scroll, animate } from "motion";
  const hiringSection = document.querySelector("#hiring-section")!;

  const hiringTeamBackground = document.querySelectorAll(".hiring-team-backgorund");

  hiringTeamBackground.forEach((el) => {
    if (el) {
      console.log("el", el);
      scroll(animate(el, { skewX: [0, -30] }), {
        target: el,
        offset: ["0 0.7", "0.5 0.5"],
      });
    }
  });

  const hiringTeamBackgroundMobile = document.querySelectorAll(".hiring-team-backgorund-mobile");

  hiringTeamBackgroundMobile.forEach((el) => {
    if (el) {
      scroll(animate(el, { skewY: [-20, -5] }), {
        target: el,
        offset: ["1 1", "1.2 1"],
      });
    }
  });

  const hiringTeamCard = document.querySelector("#hiring-team-card");

  if (hiringTeamCard) {
    scroll(
      animate(hiringTeamCard, { filter: ["blur(5px)", "blur(0px)"], x: ["-200px", 0], opacity: [0, 1] }),
      {
        target: hiringTeamCard,
        offset: ["0.5 1", "0 0.5"],
      }
    );
  }

  const hiringInvidiualCard = document.querySelector("#hiring-individual-card");

  if (hiringInvidiualCard) {
    scroll(
      animate(hiringInvidiualCard, { filter: ["blur(5px)", "blur(0px)"], x: ["100px", 0], opacity: [0, 1] }),
      {
        target: hiringSection,
        offset: ["0.4 0.5", "0.6 0.5"],
      }
    );
  }

  const hiringTeamOr = document.querySelector("#hiring-team-or");

  if (hiringTeamOr && hiringInvidiualCard) {
    scroll(animate(hiringTeamOr, { y: ["100%", 0], opacity: [0, 1] }), {
      target: hiringSection,
      offset: ["0.4 0.5", "0.5 0.5"],
    });
  }
</script>
<section
  id="hiring-section"
  class="relative z-10 bg-black border-t border-solid border-neutral-800 overflow-hidden py-20"
>
  <div class="hiring-team-backgorund hidden lg:flex absolute bg-black w-1/2 h-full top-0 left-0 z-0"></div>
  <div class="hiring-team-backgorund hidden lg:flex absolute bg-black w-full h-full top-0 -left-1/2 z-0">
  </div>
  <div
    class="hiring-team-backgorund-mobile lg:hidden absolute bg-black w-full h-1/2 top-0 left-0 z-0 skew-y-[10deg]"
  >
  </div>
  <div class="lg:hidden absolute bg-black w-full h-1/4 top-0 left-0 z-0"></div>

  <div
    class="container mx-auto flex flex-col lg:flex-row items-center lg:items-start justify-center gap-20 relative z-10 h-full min-h-[300px]"
  >
    <div class="max-w-1/2">
      <h2 id="hiring-team-card" class="text-5xl text-white/40 font-bold">
        Software endlich <span class="text-white">richtig anpacken</span>
      </h2>
      <!-- <div id="hiring-team-or" class="h-full italic self-center font-extralight text-sm tracking-widest">
      ODER
    </div> -->
    </div>

    <div class="max-w-1/2 lg:self-end">
      <h2 id="hiring-individual-card" class="text-5xl text-white/40 font-bold">
        Mit dem <br />
        <span
          class="text-7xl font-bold inline-block text-center bg-gradient-to-br from-white via-white to-primary-500 text-transparent bg-clip-text"
          >A3-Team</span
        >
      </h2>
    </div>
  </div>
</section>
