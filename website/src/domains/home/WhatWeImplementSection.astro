---
import astro from "@/assets/images/astro.svg";
import github from "@/assets/images/github.svg";
import next from "@/assets/images/next.svg";
import nuxt from "@/assets/images/nuxt.svg";
import react from "@/assets/images/react.svg";
import tailwind from "@/assets/images/tailwind.svg";
import typescript from "@/assets/images/typescript.svg";
import vue from "@/assets/images/vue.svg";
import aws from "@/assets/images/aws.svg";
import gitlab from "@/assets/images/gitlab.svg";
import kubernetes from "@/assets/images/kubernetes.svg";
import go from "@/assets/images/go.svg";
import docker from "@/assets/images/docker.svg";
import playwright from "@/assets/images/playwright.svg";
import vite from "@/assets/images/vite.svg";
import postgres from "@/assets/images/postgres.svg";
import storybook from "@/assets/images/storybook.svg";
import rust from "@/assets/images/rust.svg";

import { GradientHoverCard } from "@/domains/home/GradientHoverCard";
import shapes from "@/assets/images/pictures/shapes.jpg";
import development from "@/assets/images/pictures/development.jpg";

import { getImage, Image } from "astro:assets";
import { LogoOutline } from "@/ui/icons/LogoOutline";
import { CheckIcon, SettingsIcon, MoreHorizontalIcon } from "lucide-react";
import { Logo } from "@/ui/icons/Logo";
import { button } from "@/ui/Button";
import { OrbitingTools } from "@/domains/home/OrbitingTools";

const innerCircleIcons: TechIcon[] = [
  {
    src: (await getImage({ src: aws, width: 100, height: 100 })).src,
    alt: "aws logo",
    title: "AWS",
    href: "https://aws.amazon.com/",
  },
  {
    src: (await getImage({ src: github, width: 100, height: 100 })).src,
    alt: "github logo",
    title: "Github",
    href: "https://github.com/",
  },
  {
    src: (await getImage({ src: docker, width: 100, height: 100 })).src,
    alt: "docker logo",
    title: "Docker",
    href: "https://www.docker.com/",
  },
  {
    src: (await getImage({ src: postgres, width: 100, height: 100 })).src,
    alt: "postgres logo",
    title: "Postgres",
    href: "https://www.postgresql.org/",
  },
  {
    src: (await getImage({ src: rust, width: 100, height: 100 })).src,
    alt: "rust logo",
    title: "Rust",
    href: "https://www.rust-lang.org/",
  },
  {
    src: (await getImage({ src: gitlab, width: 100, height: 100 })).src,
    alt: "gitlab logo",
    title: "Gitlab",
    href: "https://gitlab.com/",
  },
  {
    src: (await getImage({ src: kubernetes, width: 100, height: 100 })).src,
    alt: "kubernetes logo",
    title: "Kubernetes",
    href: "https://kubernetes.io/",
  },
  {
    src: (await getImage({ src: go, width: 100, height: 100 })).src,
    alt: "go logo",
    title: "Go",
    href: "https://go.dev/",
  },
];

const outerCircleIcons: TechIcon[] = [
  {
    src: (await getImage({ src: next, width: 100, height: 100 })).src,
    alt: "next logo",
    title: "Next",
    href: "https://nextjs.org/",
  },
  {
    src: (await getImage({ src: typescript, width: 100, height: 100 })).src,
    alt: "typescript logo",
    title: "TypeScript",
    href: "https://www.typescriptlang.org/",
  },
  {
    src: (await getImage({ src: nuxt, width: 100, height: 100 })).src,
    alt: "nuxt logo",
    title: "Nuxt",
    href: "https://nuxt.com/",
  },
  {
    src: (await getImage({ src: typescript, width: 100, height: 100 })).src,
    alt: "typescript logo",
    title: "TypeScript",
    href: "https://www.typescriptlang.org/",
  },
  {
    src: (await getImage({ src: react, width: 100, height: 100 })).src,
    alt: "react logo",
    title: "React",
    href: "https://reactjs.org/",
  },
  {
    src: (await getImage({ src: vue, width: 100, height: 100 })).src,
    alt: "vue logo",
    title: "Vue",
    href: "https://vuejs.org/",
  },
  {
    src: (await getImage({ src: playwright, width: 100, height: 100 })).src,
    alt: "playwright logo",
    title: "Playwright",
    href: "https://playwright.dev/",
  },
  {
    src: (await getImage({ src: tailwind, width: 100, height: 100 })).src,
    alt: "tailwind logo",
    title: "Tailwind",
    href: "https://tailwindcss.com/",
  },
  {
    src: (await getImage({ src: astro, width: 100, height: 100 })).src,
    alt: "astro logo",
    title: "Astro",
    href: "https://astro.build/",
  },
  {
    src: (await getImage({ src: storybook, width: 100, height: 100 })).src,
    alt: "storybook logo",
    title: "Storybook",
    href: "https://storybook.js.org/",
  },
  {
    src: (await getImage({ src: vite, width: 100, height: 100 })).src,
    alt: "vite logo",
    title: "Vite",
    href: "https://vitejs.dev/",
  },
];
interface TechIcon {
  src: string;
  alt: string;
  title: string;
  href: string;
}
---

<section class="container w-full px-4 py-20 mx-auto bg-black min-h-[600px] flex relative">
  <div
    class="absolute w-[60%] h-[60%] rounded-full left-1/2 top-1/2 -translate-1/2 bg-primary-600/20 blur-[100px] z-0"
  >
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.5fr_1fr] gap-4 relative max-w-[1400px]">
    <div class="grid grid-rows-[2fr_1fr] gap-4">
      <div class="grid grid-cols-[2fr_1fr] gap-4 w-full flex-grow-1">
        <div class="grid">
          <GradientHoverCard
            client:idle
            id="web-apps-card"
            className="animate-blur-fade-in overflow-hidden backdrop-blur-xl rounded-xl border border-primary-500/50 bg-primary-500/20 flex-grow-1"
          >
            <div class="px-4 pt-4">
              <h2
                class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
              >
                Web-Apps
              </h2>
              <p class="text-lg font-serif text-neutral-400">Desktop & Mobile-friendly</p>
            </div>

            <div
              class="w-full absolute -right-[50px] -bottom-[20px] group-hover:scale-110 -rotate-5 group-hover:rotate-0 group-hover:-translate-[20px] transition-spring"
            >
              <div
                class="border-6 rounded-xl border-neutral-950 flex flex-col relative bg-neutral-950 h-[200px] overflow-hidden"
              >
                <Logo
                  className="absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-[calc(50%_+_30px)] text-black/20 flex-grow-1  w-[200%] "
                />
                <div class="w-full overflow-hidden relative bg-neutral-950 flex items-start gap-1 px-1 py-2">
                  <div class="w-[8px] h-[8px] rounded-full bg-destructive-500/50"></div>
                  <div class="w-[8px] h-[8px] rounded-full bg-warn-500/50"></div>

                  <div class="w-[8px] h-[8px] rounded-full bg-positive-500/50"></div>
                </div>
                <div class="w-full h-full bg-gradient-to-b from-primary-500 to-primary-500/0"></div>
              </div>
            </div>

            <div
              class="w-[120px] absolute right-[20px] -bottom-[40px] group-hover:scale-110 rotate-5 group-hover:rotate-0 group-hover:-translate-[10px] transition-spring"
            >
              <div
                class="rounded-xl relative border-6 border-neutral-950 bg-neutral-950 h-[150px] overflow-hidden"
              >
                <Logo
                  className="absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-[calc(50%_+_50px)] text-black/20 flex-grow-1  w-[300%] "
                />
                <div class="w-full overflow-hidden relative bg-neutral-950 flex items-start gap-1 px-1 py-2">
                  <div class="w-[8px] h-[8px] rounded-full bg-destructive-500/50"></div>
                  <div class="w-[8px] h-[8px] rounded-full bg-warn-500/50"></div>

                  <div class="w-[8px] h-[8px] rounded-full bg-positive-500/50"></div>
                </div>
                <div class="w-full h-full bg-gradient-to-b from-primary-500 to-55% to-primary-500/0"></div>
              </div>
            </div>
          </GradientHoverCard>
        </div>
        <div class="grid grid-rows-[2fr_1fr] gap-4">
          <GradientHoverCard
            client:idle
            className="animate-blur-fade-in group backdrop-blur-xl rounded-xl bg-primary-500/10 overflow-hidden"
          >
            <div class="text-2xl bg-gradient-to-br w-full h-full">
              <Image
                src={development}
                class="object-cover w-full h-full group-hover:scale-110 transition-spring"
                alt="Development"
                width="400"
                loading="lazy"
              />
            </div>
          </GradientHoverCard>
          <div class="flex">
            <GradientHoverCard
              client:idle
              gradientColor="var(--color-neutral-800)"
              className="animate-blur-fade-in group-hover backdrop-blur-xl relative rounded-xl border border-neutral-800 p-4 bg-neutral-800/30 flex  w-full h-full overflow-hidden"
            >
              <div class="w-full h-full flex items-center justify-center">
                <h2
                  class="text-4xl font-bold absolute flex top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 scale-0 blur-xl group-hover:blur-none group-hover:scale-150 group-hover:opacity-100 transition-spring"
                >
                  A3
                </h2>
              </div>
              <LogoOutline
                className="absolute flex top-1/2 left-1/2 -translate-x-1/2 translate-y-[-60%] text-white group-hover:text-primary-500 group-hover:blur-xl group-hover:opacity-0 flex-grow-1 w-[200%] group-hover:scale-50 transition-spring"
              />
              <LogoOutline
                className="absolute flex top-1/2 left-1/2 -translate-x-1/2 translate-y-[-60%] text-white group-hover:text-primary-500 group-hover:opacity-0 blur-lg flex-grow-1 w-[200%] group-hover:scale-50 transition-spring"
              />
            </GradientHoverCard>
          </div>
        </div>
      </div>
      <div class="flex">
        <GradientHoverCard
          client:idle
          gradientColor="var(--color-neutral-800)"
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl flex-grow-1 border border-neutral-800 bg-neutral-800/30 "
        >
          <div class="px-4 pt-4">
            <h2
              class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
            >
              Infrastruktur-Automatisierung
            </h2>
            <p class="text-lg font-serif text-neutral-400 transition-all">Skalierbarkeit & Pipelines</p>
          </div>
          <div
            class="flex items-center mt-4 pb-10 -translate-x-12 group-hover:translate-x-0 transition-spring"
          >
            <div class="h-[1px] w-2 bg-positive-500"></div>
            <div
              class="w-8 h-8 rounded-full bg-positive-500 border border-positive-500 flex items-center justify-center"
            >
              <CheckIcon className="text-white w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-positive-500"></div>
            <div
              class="w-8 h-8 rounded-full bg-positive-500 border border-positive-500 flex items-center justify-center"
            >
              <CheckIcon className="text-white w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-positive-500"></div>
            <div
              class="w-8 h-8 rounded-full bg-positive-500 border border-positive-500 flex items-center justify-center"
            >
              <CheckIcon className="text-white w-4 h-4" strokeWidth={2} />
            </div>
            <div class="h-[1px] w-6 bg-positive-500"></div>
            <div
              class="w-12 h-12 rounded-full bg-neutral-400/20 border border-neutral-400 flex items-center justify-center"
            >
              <MoreHorizontalIcon className="text-white w-6 h-4" strokeWidth={2} />
            </div>
            <div class="flex gap-1 mx-1">
              <div class="h-[1px] w-2 bg-neutral-400"></div>
              <div class="h-[1px] w-2 bg-neutral-400"></div>
              <div class="h-[1px] w-2 bg-neutral-400"></div>
            </div>
          </div>
        </GradientHoverCard>
      </div>
    </div>
    <div class="grid grid-cols-[1fr_2fr] lg:grid-cols-1 min-h-[300px] lg:grid-rows-[1fr_2fr] gap-4">
      <div class="flex flex-grow-1">
        <GradientHoverCard
          client:idle
          gradientColor="var(--color-neutral-800)"
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl border border-neutral-800 bg-neutral-800/30 w-full"
        >
          <div class="px-4 pt-4 pb-20 relative z-10">
            <h2
              class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
            >
              UI / UX Design
            </h2>
            <p class="text-neutral-400 text-lg font-serif">Intuitiv & Ansprechend</p>
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[200%] aspect-square inset-0 bg-primary-500/20 transition-spring rounded-full"
          >
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[200%] aspect-square -translate-y-3/4 -translate-x-1/3 inset-0 bg-primary-500/20 group-hover:delay-300 transition-spring rounded-full"
          >
          </div>
          <div
            class="group-hover:scale-100 lg:scale-0 absolute w-[400%] aspect-square -translate-y-1/4 -translate-x-3/4 inset-0 bg-primary-500/20 group-hover:delay-600 transition-spring rounded-full"
          >
          </div>
        </GradientHoverCard>
      </div>
      <div class="flex flex-grow-2">
        <GradientHoverCard
          client:idle
          className="animate-blur-fade-in overflow-hidden group backdrop-blur-xl rounded-xl flex-grow-1 border border-primary-500/50 bg-primary-500/10 "
        >
          <div class="px-4 pt-4 pb-20 relative z-10">
            <h2
              class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
            >
              Code-Analyse
            </h2>
            <p class="text-neutral-400 text-lg font-serif">Qualität & Struktur</p>
          </div>

          <div
            class="font-mono text-lg absolute bottom-0 right-0 translate-x-12 pl-4 group-hover:scale-120 transition-spring"
          >
            <div class="flex gap-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-50 group-hover:blur-none transition-spring"
              >
                def
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-100 group-hover:blur-none transition-spring"
              >
                fizzbuzz():
              </div>
            </div>

            <div class="pl-2 flex gap-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-150 group-hover:blur-none transition-spring"
              >
                for
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-200 group-hover:blur-none transition-spring"
              >
                i
              </div>
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-250 group-hover:blur-none transition-spring"
              >
                in
              </div>

              <div
                class="relative inline-block lg:blur-[4px] delay-300 group-hover:blur-none transition-spring"
              >
                <span class="text-primary-500">range</span>(1,101):
              </div>
            </div>

            <div class="pl-4 flex gap-2">
              <div
                class="relative inline-block lg:blur-[4px] delay-350 group-hover:blur-none transition-spring"
              >
                print_number
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-400 group-hover:blur-none transition-spring"
              >
                =
              </div>

              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-450 group-hover:blur-none transition-spring"
              >
                true
              </div>
            </div>

            <div class="flex gap-2 pl-2">
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-500 group-hover:blur-none transition-spring"
              >
                if
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-550 group-hover:blur-none transition-spring"
              >
                i
              </div>

              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-650 group-hover:blur-none transition-spring"
              >
                is
              </div>
              <div
                class="relative text-primary-500 inline-block lg:blur-[4px] delay-700 group-hover:blur-none transition-spring"
              >
                divisibleBy
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-750 group-hover:blur-none transition-spring"
              >
                3:
              </div>
            </div>

            <div class="flex gap-2 pl-4">
              <div
                class="relative inline-block lg:blur-[4px] delay-800 group-hover:blur-none transition-spring"
              >
                print
              </div>
              <div
                class="relative inline-block lg:blur-[4px] delay-850 group-hover:blur-none transition-spring"
              >
                "Fizz"
              </div>
            </div>
          </div>
        </GradientHoverCard>
      </div>
    </div>
    <div class="grid grid-rows-[0.3fr_1fr] gap-4 min-h-[600px]">
      <div class="flex gap-4">
        <div class="flex flex-grow-1">
          <GradientHoverCard
            client:idle
            className="animate-blur-fade-in backdrop-blur-xl rounded-xl border border-primary-500/50 bg-primary-500/10 w-full overflow-hidden relative"
          >
            <div class="px-4 pt-4 pb-20">
              <h2
                class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
              >
                Prozessoptimierung
              </h2>
              <p class="text-lg text-neutral-400 font-serif">Effizienz & Kontrolle</p>
            </div>
            <SettingsIcon
              className="absolute w-60 h-60 text-primary-500/50 fill-primary-500/10 top-1/2 right-0 translate-x-1/2 -translate-y-1/4 group-hover:rotate-[180deg] transition-spring"
              strokeWidth={0.1}
            />
          </GradientHoverCard>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="grid grid-rows-[0.5fr_1fr] gap-4">
          <div class="animate-blur-fade-in flex flex-grow-1 group relative overflow-hidden">
            <a
              href="#kontakt"
              class={button({
                class: "text-3xl w-full h-full p-4 text-center font-bold relative z-0",
              })}
            >
              <span class="relative z-10"> Projekt anfragen </span>

              <div
                class="absolute top-1/2 left-1/2 -translate-1/2 h-[120%] w-1/3 -skew-x-[30deg] bg-black/20 pointer-events-none group-hover:scale-[3] transition-spring"
              >
              </div>
            </a>
          </div>

          <div class="animate-blur-fade-in w-full h-full group relative rounded-xl overflow-hidden">
            <Image
              src={shapes}
              class="absolute object-cover w-full h-full group-hover:scale-110 transition-spring"
              alt="Shapes"
              width="400"
              fit="cover"
              loading="lazy"
              position="top"
            />
            <div class="absolute bg-black/20 w-full h-full top-0 left-0"></div>
          </div>
        </div>
        <div class="grid grid-rows-[1fr_0.5fr] gap-4">
          <div class="flex">
            <GradientHoverCard
              client:idle
              gradientColor="var(--color-neutral-800)"
              className="animate-blur-fade-in group backdrop-blur-xl relative rounded-xl border border-neutral-800  bg-neutral-800/30 flex  w-full h-full overflow-hidden"
            >
              <div
                class="absolute top-1/2 left-1/2 -translate-1/2 w-full h-full flex gap-4 flex-wrap max-w-7xl align-center justify-center"
              >
                <div
                  class="relative h-[700px] w-full flex items-center justify-center grayscale group-hover:grayscale-0 group-hover:scale-110 transition-spring"
                >
                  <OrbitingTools
                    tools={outerCircleIcons}
                    client:idle
                    iconSize={40}
                    radius={250}
                    speed={0.5}
                  />
                  <OrbitingTools
                    tools={innerCircleIcons}
                    client:idle
                    iconSize={40}
                    radius={150}
                    reverse
                    speed={0.7}
                  />
                </div>
                <!-- {
                  shuffledIcons.map((icon) => (
                    <a href={icon.href} title={icon.title} target="_blank" class="tech-stack-icon grayscale ">
                      <Image
                        src={icon.src}
                        alt={icon.alt}
                        width="50"
                        height="50"
                        class="transition-all duration-300 size-8"
                      />
                    </a>
                  ))
                } -->
              </div>
            </GradientHoverCard>
          </div>
          <div class="animate-blur-fade-in flex flex-grow-1">
            <div class="backdrop-blur-sm flex items-end justify-end rounded-xl flex-grow-1 bg-black/20 p-4">
              <h2
                class="text-2xl bg-gradient-to-br from-white via-white to-neutral-500 text-transparent bg-clip-text"
              >
                Und mehr...
              </h2>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<div class="container mx-auto flex items-center justify-center py-10"></div>
