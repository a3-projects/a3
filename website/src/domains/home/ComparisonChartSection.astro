---
import { ComparisonLineChart } from "@/ui/ComparisonLineChart";
import { TextHighlight } from "@/ui/TextHighlight";
import { CheckIcon, XIcon, GitCommitHorizontal } from "lucide-react";
---

<section class="animate-blur-fade-in py-20 relative overflow-hidden">
  <div class="container max-w-6xl mx-auto px-4 relative z-10">
    <div class="text-center mb-16">
      <h2
        class="animate-blur-fade-in ty-headline-lg inline-block bg-gradient-to-br from-front via-front to-muted-front text-transparent bg-clip-text"
      >
        A3 Team vs. Traditionelle Agentur
      </h2>
      <p class="animate-blur-fade-in ty-subtitle-lg text-muted-front mt-4 max-w-2xl mx-auto">
        <TextHighlight>Schneller zum Ziel</TextHighlight> mit kalkulierbarem Budget – wir starten mit einem MVP
        und entwickeln kontinuierlich weiter.
      </p>
    </div>

    <ComparisonLineChart
      client:idle
      data={[
        { name: "Start", mvp: 0, traditional: 0 },
        { name: "14 Tage", mvp: 40, traditional: 5 },
        { name: "Jahr 1", mvp: 80, traditional: 25 },
        { name: "Jahr 2", mvp: 90, traditional: 35 },
        { name: "Jahr 3", mvp: 95, traditional: 45 },
      ]}
      lines={[
        {
          dataKey: "mvp",
          label: "A3 Team",
          color: "var(--color-primary-500)",
        },
        {
          dataKey: "traditional",
          label: "Traditionelle Agentur",
          color: "var(--color-neutral-400)",
        },
      ]}
      yAxisLabel="Fortschritt"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mt-8">
      <!-- MVP Column -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <GitCommitHorizontal size={32} className="text-primary-500" strokeWidth={2.5} />
          <h3 class="ty-headline-sm text-front">A3 Team</h3>
        </div>

        <ul class="space-y-4 ty-body-md text-muted-front">
          <li class="flex items-start gap-3">
            <CheckIcon size={20} className="shrink-0 mt-0.5 text-primary-back" />
            <span>Schneller Start – <TextHighlight>14 Tage</TextHighlight> bis zum ersten Prototyp</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckIcon size={20} className="shrink-0 mt-0.5 text-primary-back" />
            <span><TextHighlight>Kalkulierbares Budget</TextHighlight> durch iterative Entwicklung</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckIcon size={20} className="shrink-0 mt-0.5 text-primary-back" />
            <span
              ><TextHighlight>Ein eingespieltes Team</TextHighlight> – weniger Abstimmung, mehr Ergebnisse</span
            >
          </li>
        </ul>
      </div>

      <!-- Traditional Column -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <GitCommitHorizontal size={32} className="text-neutral-400" strokeWidth={2.5} />
          <h3 class="ty-headline-sm text-front">Traditionelle Agentur</h3>
        </div>

        <ul class="space-y-4 ty-body-md text-muted-front">
          <li class="flex items-start gap-3">
            <XIcon size={20} className="shrink-0 mt-0.5 text-neutral-400" />
            <span>Monate der Planung vor dem ersten Code</span>
          </li>
          <li class="flex items-start gap-3">
            <XIcon size={20} className="shrink-0 mt-0.5 text-neutral-400" />
            <span>Budget oft 2-3x überschritten</span>
          </li>
          <li class="flex items-start gap-3">
            <XIcon size={20} className="shrink-0 mt-0.5 text-neutral-400" />
            <span>Wechselnde Ansprechpartner, lange Abstimmungswege</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
